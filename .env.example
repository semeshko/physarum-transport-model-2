# Obtain your own browser Basemaps key at https://carto.com/basemaps/apikey/
# Copy this file to .env.local; do not commit a real key.
# NEXT_PUBLIC values are visible in the browser and frozen at build time.
# Use a Basemaps-only key with restrictions for your app's domains.
NEXT_PUBLIC_CARTO_API_KEY=

# Optional identifying contact URL sent only by the server to OSM providers.
OSM_CONTACT_URL=https://github.com/semeshko/physarum-transport-model-2
